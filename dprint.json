{
  // modify_ scripts are Go templates, so they do not parse as TOML
  "excludes": ["sync", "src/dot_codex/modify_private_config.toml"],
  "markdown": {
    "textWrap": "maintain"
  },
  "toml": {
    // Keeps the `#:schema` directive from being mangled into `# :schema`
    "comment.forceLeadingSpace": false
  },
  "plugins": [
    "https://plugins.dprint.dev/json-0.23.0.wasm",
    "https://plugins.dprint.dev/markdown-0.23.2.wasm",
    "https://plugins.dprint.dev/toml-0.8.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm"
  ]
}
