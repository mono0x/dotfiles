#!/bin/bash
# Review a branch or PR with Codex in a worktree managed by wt-herdr-run.
set -euo pipefail

if (($# != 1)); then
  printf '%s\n' 'usage: review <branch|pr:N|mr:N|PR-URL>' >&2
  exit 2
fi

if [[ $1 != --worker ]]; then
  self=$(cd -- "$(dirname -- "$0")" && pwd -P)/${0##*/}
  exec wt-herdr-run "$1" -- "$self" --worker
fi

base=$(wt list --format json | jq -er '.repo.default_branch')
codex review -c model=gpt-6-astra --base "$base"
codex resume --last --include-non-interactive --model gpt-6-astra
