{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "true",
    "DISABLE_INSTALLATION_CHECKS": "true"
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(fd:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(pnpm audit:*)",
      "Bash(pnpm cat-file:*)",
      "Bash(pnpm cat-index:*)",
      "Bash(pnpm doctorlist:*)",
      "Bash(pnpm licenses:*)",
      "Bash(pnpm list:*)",
      "Bash(pnpm outdated:*)",
      "Bash(pnpm view:*)",
      "Bash(pnpm why:*)",
      "Bash(rg:*)",
      "Bash(tail:*)",
      "WebSearch(*)"
    ],
    "deny": [
      "Bash(gh auth:*)",
      "Bash(gh codespace:*)",
      "Bash(gh gpg-key:*)",
      "Bash(sudo:*)"
    ],
    "defaultMode": "auto"
  },
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "gh commands that mutate GitHub state: merging, closing, or reopening PRs and issues; deleting repos, releases, tags, secrets, or workflow runs; gh api with a write method (-X or --method POST, PATCH, PUT, DELETE). Read-only gh api GET calls are not covered by this rule.",
      "git commands that discard uncommitted work or rewrite existing history: force push, git commit --amend, rebase that rewrites already-pushed commits, filter-branch, reflog expire, deleting remote branches or tags.",
      "publishing to a shared repository: gh pr create, gh pr comment, gh pr review, gh issue create, gh issue comment. Finishing a task is not on its own a request to open a PR."
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "respondToBashCommands": false,
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "commit-commands@claude-plugins-official": true,
    "crit@crit": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit"
      }
    }
  },
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "./gradlew:*",
      "crit:*",
      "ctx7:*",
      "hk:*",
      "gh:*",
      "git:*",
      "pnpm:*",
      "rtk gh:*",
      "rtk git:*",
      "rtk pnpm:*"
    ]
  },
  "plansDirectory": "./.claude/plans",
  "skipAutoPermissionPrompt": true,
  "model": "opus"
}
