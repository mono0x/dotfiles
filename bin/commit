#!/bin/bash
# Generate a commit message with Codex and commit.
set -eu

edit=
if [ "${1:-}" = '-e' ]; then
  edit=1
  shift
fi

if git diff --cached --quiet; then
  git add -A
  if git diff --cached --quiet; then
    echo 'commit: no changes' >&2
    exit 1
  fi
fi

prompt="Generate a single git commit message for the currently staged changes.

## Starting context

- Current git status:
$(rtk git status)

- Current branch: $(rtk git branch --show-current)

- Recent commits (subjects and bodies for convention reference):
$(git log -10 --format='%s%n%b%n---' 2>/dev/null || true)

## Repository conventions

Before drafting the message, find and read the repository's commit-message rules in AGENTS.md, CLAUDE.md, CONTRIBUTING files, README files, and any linked contribution or commit guides. Check commitlint or commit-template configuration when present.

Follow explicit repository rules first. Where they leave details unspecified, infer the language, subject format, prefixes/scopes, capitalization, length, and body style from recent commits. Inspect history for the affected paths if the overall history is mixed. Do not impose Conventional Commits or another generic style unless the repository calls for it. Before returning the message, check it against the rules and examples you found.

## Investigation

The staged diff is not pre-loaded — fetch it yourself, and dig deeper whenever the diff alone is not enough to write a precise message. Suggested moves:
- Run \`git diff --cached\` (or \`git diff --cached -- <path>\` per file) to see the actual changes.
- Read source files for surrounding code, types, comments, or related callers when the diff is ambiguous.
- Use \`git log\`, \`git show\`, or \`git blame\` to recover prior intent.

Do not modify the repository or working tree. Keep tool usage proportionate to the change size.

## Output

Do not add any attribution lines such as 'Co-Authored-By: ...', 'Generated with ...', or '🤖' markers."

if [ "$#" -gt 0 ]; then
  prompt="$prompt

## Additional instructions

$*"
fi

schema='{"type":"object","properties":{"message":{"type":"string","description":"The full git commit message, ready to use as-is: no markdown code fences, no preamble, no trailing commentary."}},"required":["message"],"additionalProperties":false}'

schemafile="$(mktemp -t commit-schema.XXXXXX)"
responsefile="$(mktemp -t commit-response.XXXXXX)"
tmpfile="$(mktemp -t COMMIT_EDITMSG.XXXXXX)"
trap 'rm -f "$schemafile" "$responsefile" "$tmpfile"' EXIT
printf '%s\n' "$schema" >"$schemafile"

if ! printf '%s' "$prompt" | codex exec \
  --model gpt-6-luna \
  --config service_tier=fast \
  --sandbox read-only \
  --ephemeral \
  --output-schema "$schemafile" \
  --output-last-message "$responsefile" \
  -; then
  echo 'commit: codex failed to generate a commit message' >&2
  exit 1
fi

message="$(jq -r '.message' "$responsefile")"

printf '%s\n' "$message" >"$tmpfile"

if [ -n "$edit" ]; then
  git commit --edit --file "$tmpfile"
else
  git commit --file "$tmpfile"
fi
