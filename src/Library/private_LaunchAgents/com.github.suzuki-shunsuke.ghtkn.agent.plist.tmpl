<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.github.suzuki-shunsuke.ghtkn.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/ghtkn</string>
		<string>agent</string>
		<string>start</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- `ghtkn agent stop` exits successfully, so restart only on failure. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/ghtkn-agent.log</string>
</dict>
</plist>
