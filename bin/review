#!/bin/bash
# Review a branch or PR with Codex in a worktree managed by wt-herdr-run.
set -euo pipefail

if (($# != 1)); then
  printf '%s\n' 'usage: review <branch|N|pr:N|mr:N|PR-URL>' >&2
  exit 2
fi

if [[ $1 != --worker ]]; then
  self=$(cd -- "$(dirname -- "$0")" && pwd -P)/${0##*/}
  target=$1
  if [[ $target =~ ^https?://([^/]+)/([^/]+)/([^/]+)/pull/([0-9]+)([/#?].*)?$ ]]; then
    repository=${BASH_REMATCH[1]}/${BASH_REMATCH[2]}/${BASH_REMATCH[3]}
    target=pr:${BASH_REMATCH[4]}
    repo=$(ghq list --exact --full-path "$repository")
    if [[ -z $repo || $repo == *$'\n'* ]]; then
      printf '%s\n' "review: expected one ghq repository for $repository" >&2
      exit 1
    fi
    cd -- "$repo"
  elif [[ $target =~ ^[0-9]+$ ]]; then
    target=pr:$target
  fi
  exec wt-herdr-run --workspace review "$target" -- "$self" --worker
fi

base=$(wt list --format json | jq -er '.repo.default_branch')
codex review -c model=gpt-6.1-sol -c model_reasoning_effort=high --base "$base"
codex resume --last --include-non-interactive --model gpt-6.1-sol -c model_reasoning_effort=high
