#!/bin/bash
set -euo pipefail

printf '%s\n' '#:schema https://developers.openai.com/codex/config-schema.json'
# shellcheck disable=SC2016
sed '/^#:schema https:\/\/developers.openai.com\/codex\/config-schema.json$/d' |
  mise --cd "{{ .chezmoi.sourceDir }}" exec -- tomlq -T \
    --arg uv "$HOME/.cache/uv" \
    --arg gradle "$HOME/.gradle" \
    --arg dprint "$HOME/Library/Caches/dprint" '
      .approvals_reviewer = "auto_review"
      | .model = "gpt-6.1-sol"
      | .model_reasoning_effort = "medium"
      | .personality = "pragmatic"
      | .sandbox_workspace_write.network_access = true
      | .sandbox_workspace_write.writable_roots = [$uv, $gradle, $dprint]
      | .features.network_proxy.enabled = true
      | .features.network_proxy.domains = {
          "api.github.com": "allow",
          "golang.flatt.tech": "allow",
          "npm.flatt.tech": "allow",
          "registry.npmjs.org": "allow"
        }
      | .agents.enabled = true
      | .agents.default_subagent_model = "gpt-6-luna"
      | .agents.default_subagent_reasoning_effort = "max"
      | .agents.max_concurrent_threads_per_session = 2
      | .tui.status_line = ["model-with-reasoning", "context-remaining", "current-dir", "git-branch", "pull-request-number", "branch-changes", "weekly-limit"]
      | .tui.status_line_use_colors = true
    '
