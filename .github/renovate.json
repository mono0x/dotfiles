{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>mono0x/renovate-config:dprint-plugins",
    "github>mono0x/renovate-config:hk-pkl"
  ],
  "timezone": "Asia/Tokyo",
  "minimumReleaseAge": "2 days",
  "osvVulnerabilityAlerts": true,
  "group": {
    "commitMessageTopic": "{{#if upgrades.[1]}}{{{groupName}}}{{else}}{{{depName}}}{{/if}}",
    "commitMessageExtra": "{{#unless upgrades.[1]}}to {{#if isPinDigest}}{{{newDigestShort}}}{{else}}{{#if isMajor}}{{prettyNewMajor}}{{else}}{{#if isSingleVersion}}{{prettyNewVersion}}{{else}}{{#if newValue}}{{{newValue}}}{{else}}{{{newDigestShort}}}{{/if}}{{/if}}{{/if}}{{/if}}{{/unless}}"
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/\\.chezmoiexternal\\.toml\\.tmpl$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) currentValue=(?<currentValue>\\S+)\\s+url = \"https://raw\\.githubusercontent\\.com/(?<depName>[^/]+/[^/]+)/(?<currentDigest>[0-9a-f]+)/",
        "# renovate: datasource=(?<datasource>\\S+) currentValue=(?<currentValue>\\S+)\\s+url = \"https://github\\.com/(?<depName>[^/]+/[^/]+)/archive/(?<currentDigest>[0-9a-f]+)\\.tar\\.gz\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/dot_config/sheldon/plugins\\.toml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) currentValue=(?<currentValue>\\S+)\\s+github = \"(?<depName>[^\"]+)\"\\s+rev = \"(?<currentDigest>[0-9a-f]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Branch-tracking digests have no release timestamp, so minimumReleaseAge cannot be enforced for them",
      "matchDatasources": [
        "github-digest"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "src/.chezmoiexternal.toml.tmpl"
      ],
      "groupName": "chezmoi externals",
      "schedule": [
        "* * * * 1"
      ]
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "src/dot_config/sheldon/plugins.toml"
      ],
      "groupName": "sheldon plugins",
      "schedule": [
        "* * * * 1"
      ]
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "dprint.json"
      ],
      "groupName": "dprint plugins",
      "schedule": [
        "* * * * 1"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "GitHub Actions",
      "schedule": [
        "* * 1 * *"
      ]
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "mise tools",
      "schedule": [
        "* * * * 1"
      ]
    },
    {
      "matchDepNames": [
        "hk-pkl"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "mise tools",
      "schedule": [
        "* * * * 1"
      ]
    }
  ]
}
