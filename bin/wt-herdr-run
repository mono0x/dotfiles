#!/bin/bash
# Run a command in a worktree, using a new Herdr workspace when available.
set -euo pipefail

usage() {
  printf '%s\n' 'usage: wt-herdr-run [--create] [--workspace NAME] <branch|pr:N|mr:N|PR-URL> -- <command> [arg ...]' >&2
  return 2
}

require() {
  command -v "$1" >/dev/null 2>&1 || {
    printf '%s\n' "wt-herdr-run: required command not found: $1" >&2
    return 127
  }
}

worker() {
  local repo=$1 worktree=$2 owned=$3
  shift 3
  [[ ${1:-} == -- ]] || usage
  shift
  (($# > 0)) || usage

  cd -- "$worktree" || return
  local exit_code=0
  "$@" || exit_code=$?
  if ((exit_code != 0)); then
    printf '%s\n' "wt-herdr-run: command exited with status $exit_code; keeping worktree: $worktree" >&2
    return "$exit_code"
  fi

  cd -- "$repo" || return
  if [[ $owned == true ]]; then
    # Only remove worktrees created by this invocation, keeping branches and changes.
    if ! wt -C "$repo" remove --foreground --yes --no-delete-branch "$worktree"; then
      printf '%s\n' "wt-herdr-run: cleanup failed; keeping worktree: $worktree" >&2
      return 1
    fi
  fi
}

require wt
require jq

if [[ ${1:-} == --worker ]]; then
  shift
  (($# >= 5)) || usage
  worker "$@"
  exit $?
fi

switch_args=(--no-cd --format json)
workspace_label=''
while (($# > 0)); do
  case $1 in
  --create)
    switch_args+=(--create)
    shift
    ;;
  --workspace)
    (($# >= 2)) && [[ -n $2 ]] || usage
    workspace_label=$2
    shift 2
    ;;
  *) break ;;
  esac
done
(($# >= 3)) || usage
target=$1
shift
[[ $1 == -- && -n $target && $target != --* ]] || usage
shift
require "$1"
require git

if [[ ${HERDR_ENV:-} == 1 ]]; then
  require herdr
fi

repo=$(git rev-parse --show-toplevel)
# switch reports whether it created or reused the worktree, including PR/MR targets.
selection=$(wt -C "$repo" switch "${switch_args[@]}" "$target")
worktree=$(jq -er '.path | select(type == "string" and length > 0)' <<<"$selection")
owned=$(jq -er '.action |
  if . == "created" then "true"
  elif . == "existing" or . == "already_at" then "false"
  else error("unknown switch action") end' <<<"$selection")
[[ -d $worktree ]] || {
  printf '%s\n' "wt-herdr-run: worktree directory not found: $worktree" >&2
  exit 1
}

self=$(cd -- "$(dirname -- "$0")" && pwd -P)/${0##*/}
cd -- "$worktree"
exec "${self%/*}/herdr-run" --workspace "${workspace_label:-$target}" -- \
  /bin/bash "$self" --worker "$repo" "$worktree" "$owned" -- "$@"
