#!/bin/bash
# Review a branch or PR with Codex in a temporary worktree.
set -euo pipefail

if [ "$#" -lt 1 ]; then
  echo 'usage: review <branch|pr:N|mr:N|PR-URL>' >&2
  exit 1
fi

target="$1"
if [ "$#" -ne 1 ]; then
  echo 'review: extra prompts are not supported with codex review --base' >&2
  exit 1
fi

if [ "${HERDR_ENV:-}" = 1 ] && [ -n "${REVIEW_HERDR_WORKTREE:-}" ]; then
  path="$REVIEW_HERDR_WORKTREE"
  unset REVIEW_HERDR_WORKTREE
  trap 'herdr tab close "$HERDR_TAB_ID" >/dev/null' EXIT
else
  # Shell integration does not apply here, so track the worktree path explicitly.
  path="$(wt switch "${target}" --no-cd --format json | jq -r .path)"

  if [ "${HERDR_ENV:-}" = 1 ]; then
    tab="$(herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$path" --focus)"
    tab_id="$(jq -er '.result.root_pane.tab_id' <<<"$tab")"
    pane_id="$(jq -er '.result.root_pane.pane_id' <<<"$tab")"
    printf -v command 'exec env REVIEW_HERDR_WORKTREE=%q %q %q' "$path" "$(realpath "$0")" "$target"
    if herdr pane run "$pane_id" "$command" >/dev/null; then
      exit 0
    else
      status=$?
      herdr tab close "$tab_id" >/dev/null
      exit "$status"
    fi
  fi
fi

origin="$PWD"
# Herdr follows the foreground process-group leader's cwd when opening tabs.
cd "$path"

if [ "${HERDR_ENV:-}" = 1 ]; then
  number="$(herdr tab get "$HERDR_TAB_ID" | jq -er '.result.tab.number')"
  branch="$(git -C "$path" branch --show-current)"
  herdr tab rename "$HERDR_TAB_ID" "$number ${branch:-${path##*/}}" >/dev/null
fi

base="$(wt -C "${path}" list --format json | jq -er .repo.default_branch)"

status=0
(codex review -c model=gpt-6-astra --base "${base}" && codex resume --last --include-non-interactive --model gpt-6-astra) || status=$?

case "${status}" in
# Treat Ctrl+C (130) as an intentional exit when reviewing.
0 | 130)
  cd "$origin"
  wt remove --force "${path}"
  ;;
*)
  echo "review: codex exited with status ${status}; keeping worktree for inspection" >&2
  exit "${status}"
  ;;
esac
