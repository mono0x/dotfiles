{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>mono0x/renovate-config:dprint-plugins",
    "github>mono0x/renovate-config:hk-pkl"
  ],
  "timezone": "Asia/Tokyo",
  "minimumReleaseAge": "2 days",
  "osvVulnerabilityAlerts": true,
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/\\.chezmoiexternal\\.toml\\.tmpl$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) currentValue=(?<currentValue>\\S+)\\s+url = \"https://raw\\.githubusercontent\\.com/(?<depName>[^/]+/[^/]+)/(?<currentDigest>[0-9a-f]+)/",
        "# renovate: datasource=(?<datasource>\\S+) currentValue=(?<currentValue>\\S+)\\s+url = \"https://github\\.com/(?<depName>[^/]+/[^/]+)/archive/(?<currentDigest>[0-9a-f]+)\\.tar\\.gz\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/dot_config/sheldon/plugins\\.toml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) currentValue=(?<currentValue>\\S+)\\s+github = \"(?<depName>[^\"]+)\"\\s+rev = \"(?<currentDigest>[0-9a-f]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Branch-tracking digests have no release timestamp, so minimumReleaseAge cannot be enforced for them",
      "matchDatasources": [
        "github-digest"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Automerge everything except major updates, in a monthly batch",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "schedule": ["* * 1 * *"],
      "automerge": true
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "src/.chezmoiexternal.toml.tmpl"
      ],
      "groupName": "chezmoi externals"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "src/dot_config/sheldon/plugins.toml"
      ],
      "groupName": "sheldon plugins"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "dprint.json"
      ],
      "groupName": "dprint plugins"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "mise tools"
    },
    {
      "matchDepNames": [
        "hk-pkl"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "mise tools"
    }
  ]
}
