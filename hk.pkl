amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Builtins.pkl"

exclude = List("sync/**")

local linters = new Mapping<String, Step> {
  ["dprint"] = (Builtins.dprint) {
    glob = "**/*.{json,jsonc,md,yaml,yml,toml}"
  }
  ["shellcheck"] = Builtins.shellcheck
  ["shfmt"] = (Builtins.shfmt) {
    match_any =
      Builtins.shfmt.match_any
        + List(new FileSelector {
          glob = List("src/dot_zshenv", "src/dot_zprofile")
        })
  }
  ["bash"] {
    glob = List("**/*.sh")
    check = "bash -n {{ files }}"
  }
  ["zsh"] {
    glob = List("**/*.zsh", "src/dot_zshenv", "src/dot_zprofile")
    check = "zsh -n {{ files }}"
  }
  ["zshellcheck"] {
    glob = List("**/*.zsh", "src/dot_zshenv", "src/dot_zprofile")
    check = "zshellcheck -no-banner {{ files }}"
    fix = "zshellcheck -no-banner -fix {{ files }}"
    batch = true
  }
  ["jactionlint"] {
    glob = List(".github/workflows/*.{yaml,yml}", "**/action.{yaml,yml}")
    batch = true
    diagnostic_format = "sarif"
    check = "jactionlint --format sarif {{ files }}"
  }
  ["pkl"] = Builtins.pkl
  ["pkl-format"] = Builtins.pkl_format
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["post-tool-use"] {
    fix = true
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
